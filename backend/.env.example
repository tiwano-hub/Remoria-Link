# PostgreSQL 接続文字列
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/remoria_link?schema=public"

# サーバ
PORT=4000
NODE_ENV=development

# CORS 許可するフロントエンドのオリジン
FRONTEND_ORIGIN="http://localhost:5173"

# JWT セッション署名鍵（本番は十分に長いランダム値）
JWT_SECRET="change-me-to-a-long-random-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google カレンダー連携用サービスアカウント JSON（1行・任意）
# 未設定の場合カレンダー連携はスキップされます
GOOGLE_CALENDAR_CREDENTIALS=""

# アプリの公開URL（契約書/領収書URL生成に使用）
APP_PUBLIC_URL="http://localhost:5173"

# 本番で簡易ログイン（メールのみ）を許可するか。Google認証設定前の初期アクセス用。
# 運用開始後は false（または未設定）にして Google 認証へ切り替えてください。
ALLOW_SIMPLE_LOGIN="false"

# 一時的にログインを停止する（停止したいときだけ "true"）
LOGIN_DISABLED="false"

# AIサポート（使い方チャット）用 Anthropic API キー（任意・未設定なら機能オフ）
ANTHROPIC_API_KEY=""

# メール送信（SMTP）。すべて設定するとメール送信が有効化（任意）
# 例: Gmail の場合 SMTP_HOST="smtp.gmail.com" SMTP_PORT=587 SMTP_SECURE="false"
#     SMTP_PASS には Google アカウントの「アプリ パスワード」を使用
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# SMS送信（Twilio）。すべて設定するとSMS送信が有効化（任意）
# TWILIO_FROM は Twilio で取得した送信元番号（例: +1xxxxxxxxxx）
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
